{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["creation/**/*.ts", "src/**/*.ts"]
}
