{
    "name": "patterns",
    "version": "1.0.0",
    "private": true,
    "description": "This repository contains patterns examples in Typescript, Python languages.",
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"**/*.{ts,js,json}\"",
        "check": "npm run typecheck && npm run lint && npm run format:check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/VolodymyrTymets/patterns.git"
    },
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/VolodymyrTymets/patterns/issues"
    },
    "homepage": "https://github.com/VolodymyrTymets/patterns#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0"
    }
}
